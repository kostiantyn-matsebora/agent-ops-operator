{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh paint",
            "timeout": 5,
            "statusMessage": "Setting window title"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh paint",
            "timeout": 5,
            "statusMessage": "Setting window title"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh paint",
            "timeout": 5,
            "statusMessage": "Setting window title"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh clean",
            "timeout": 5,
            "statusMessage": "Clearing window title"
          }
        ]
      }
    ]
  }
}
