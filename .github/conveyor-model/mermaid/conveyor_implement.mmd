stateDiagram-v2
    direction LR
    [*] --> ready
    note left of ready
        conveyor.implement  --  subject: issue
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state ready
    state implementing
    state implemented
    state implemented_with_issues
    state ready_to_merge
    state done
    state merge_failed
    ready --> implementing : implement_fired [has_access AND NOT is_session_at_work] / fire
    implementing --> implementing : implement_fired [has_access AND NOT is_session_at_work] / fire
    implementing --> implemented : prs_are_created [has_open_prs]
    implemented --> ready_to_merge : checks_completed [all_pr_mergeable]
    implemented --> implemented_with_issues : checks_completed [NOT all_pr_mergeable]
    ready_to_merge --> done : all_prs_merged [all_prs_merged AND master_is_green]
    ready_to_merge --> merge_failed : all_prs_merged [all_prs_merged AND NOT master_is_green]
    implemented_with_issues --> [*]
    done --> [*]
    merge_failed --> [*]
    class ready, implementing, implemented, implemented_with_issues, ready_to_merge, done, merge_failed stationState
