stateDiagram-v2
    direction LR
    [*] --> station_ready
    note left of station_ready
        conveyor.implement  --  subject: issue
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    state "station:ready" as station_ready
    state "station:implementing" as station_implementing
    state "station:implemented" as station_implemented
    state "station:implemented_with_issues" as station_implemented_with_issues
    state "station:ready_to_merge" as station_ready_to_merge
    state "station:done" as station_done
    state "station:merge_failed" as station_merge_failed
    station_ready --> station_implementing : conveyor.implement [has_access AND NOT is_session_at_work] / fire
    station_implementing --> station_implementing : conveyor.implement [has_access AND NOT is_session_at_work] / fire
    station_implementing --> station_implemented : prs_are_created [has_open_prs]
    station_implemented --> station_ready_to_merge : checks_completed [all_prs_mergeable]
    station_implemented --> station_implemented_with_issues : checks_completed [NOT all_prs_mergeable]
    station_ready_to_merge --> station_done : all_prs_merged [all_prs_merged AND master_is_green]
    station_ready_to_merge --> station_merge_failed : all_prs_merged [all_prs_merged AND NOT master_is_green]
    station_implemented_with_issues --> [*]
    station_done --> [*]
    station_merge_failed --> [*]
    class station_ready, station_implementing, station_implemented, station_implemented_with_issues, station_ready_to_merge, station_done, station_merge_failed stationState
