stateDiagram-v2
    [*] --> capped
    note left of capped
        conveyor.keep_going  --  subject: pull_request
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state capped
    state running
    capped --> running : round.start [NOT is_fork(pr) AND has_write_access(placer) AND is_capped(pr)] / gate()
    running --> [*]
    class capped, running loopState
    state running {
        [*] --> loop_none
        state loop_none
        state loop_running
        state loop_waiting
        state loop_stalled
        state loop_capped
        state loop_mergeable
        loop_none --> loop_mergeable : ci.green_clean / carry_fix()
        loop_running --> loop_running : end.continue / ending()
        loop_running --> loop_mergeable : end.mergeable / ending()
        loop_running --> loop_waiting : end.waiting / ending()
        loop_running --> loop_stalled : end.stalled / ending()
        loop_running --> loop_capped : end.capped / ending()
        loop_running --> loop_waiting : recover.waiting [NOT is_capped(pr) AND has_open_thread(pr)] / recover()
        loop_running --> loop_capped : recover.capped [is_capped(pr)] / recover()
        loop_waiting --> loop_running : round.start / gate()
        loop_waiting --> loop_mergeable : ci.green_clean / carry_fix()
        loop_stalled --> loop_running : round.start / gate()
        loop_stalled --> loop_mergeable : ci.green_clean / carry_fix()
        loop_capped --> loop_mergeable : ci.green_clean / carry_fix()
        loop_mergeable --> loop_mergeable : ci.green_clean / carry_fix()
        loop_mergeable --> loop_waiting : thread.opened / refresh()
        loop_mergeable --> loop_running : round.start / gate()
    }
