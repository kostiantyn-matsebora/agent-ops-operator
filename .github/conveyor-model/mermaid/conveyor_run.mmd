        state "conveyor.fix" as station_implemented_with_issues__conveyor_fix
    }
    class station_implemented_with_issues__conveyor_fix stationState
    state station_merge_failed {
        [*] --> station_merge_failed__conveyor_fix
        state "conveyor.fix" as station_merge_failed__conveyor_fix
    }
    class station_merge_failed__conveyor_fix stationState
    state station_done {
        [*] --> station_done__conveyor_finalize
        state "conveyor.finalize" as station_done__conveyor_finalize
    }
    class station_done__conveyor_finalize stationState
