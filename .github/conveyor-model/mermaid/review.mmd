stateDiagram-v2
    direction LR
    [*] --> scan_none
    note left of scan_none
        review  --  subject: pull_request
    end note
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state "scan:none" as scan_none
    state "scan:running" as scan_running
    state "scan:clean" as scan_clean
    state "scan:found_issues" as scan_found_issues
    state "scan:skipped" as scan_skipped
    state "scan:failed" as scan_failed
    scan_none --> scan_running : review.pr_pushed
    scan_running --> scan_clean : review.run_completed [review_run_succeeded AND NOT has_open_review_threads]
    scan_running --> scan_found_issues : review.run_completed [review_run_succeeded AND has_open_review_threads] / notify_findings
    scan_running --> scan_skipped : review.run_completed [review_run_skipped]
    scan_running --> scan_failed : review.run_completed [NOT review_run_succeeded AND NOT review_run_skipped] / notify_failure
    scan_clean --> scan_running : review.pr_pushed
    scan_found_issues --> scan_running : review.pr_pushed
    scan_skipped --> scan_running : review.pr_pushed
    scan_failed --> scan_running : review.pr_pushed
    class scan_none, scan_running, scan_clean, scan_found_issues, scan_skipped, scan_failed loopState
