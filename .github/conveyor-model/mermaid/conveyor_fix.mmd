stateDiagram-v2
    direction LR
    [*] --> implemented_with_issues
    [*] --> merge_failed
    note left of implemented_with_issues
        conveyor.fix  --  subject: issue
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state implemented_with_issues
    state merge_failed
    state hotfix_created
    state fixing
    state mergeable
    state done
    implemented_with_issues --> fixing : round_started
    merge_failed --> hotfix_created : hotfix_started [hotfix_pr_is_created AND all_checks_ran]
    hotfix_created --> fixing : round_started
    fixing --> mergeable : loop_entered_mergeable
    mergeable --> done : all_prs_merged [all_prs_merged]
    done --> [*]
    class implemented_with_issues, merge_failed, hotfix_created, fixing, mergeable, done stationState
    state fixing {
        [*] --> fixing__loop
        state "loop" as fixing__loop
    }
