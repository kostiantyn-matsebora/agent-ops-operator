stateDiagram-v2
    direction LR
    [*] --> station_implemented_with_issues
    [*] --> station_merge_failed
    note left of station_implemented_with_issues
        conveyor.fix  --  subject: issue
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state "station:implemented_with_issues" as station_implemented_with_issues
    state "station:merge_failed" as station_merge_failed
    state "station:hotfix_created" as station_hotfix_created
    state "station:fixing" as station_fixing
    state "station:mergeable" as station_mergeable
    state "station:done" as station_done
    station_implemented_with_issues --> station_fixing : loop.fix
    station_merge_failed --> station_hotfix_created : hotfix_started [hotfix_pr_is_created AND all_checks_ran]
    station_hotfix_created --> station_fixing : loop.fix
    station_fixing --> station_mergeable : loop_entered_mergeable
    station_mergeable --> station_done : all_prs_merged [all_prs_merged]
    station_done --> [*]
    class station_implemented_with_issues, station_merge_failed, station_hotfix_created, station_fixing, station_mergeable, station_done stationState
    state station_fixing {
        [*] --> station_fixing__loop
        state "loop" as station_fixing__loop
    }
