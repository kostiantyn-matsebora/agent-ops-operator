stateDiagram-v2
    [*] --> none
    note left of none
        conveyor.fix  --  subject: pull_request
    end note
    classDef stationState fill:#e8d5b5,stroke:#8a6d3b,color:#4a3b1f
    classDef loopState fill:#c9e4de,stroke:#2f6b5e,color:#1a3b33
    state none
    state running
    none --> running : round.start [g1], round.start [g2]
    running --> [*]
    class none, running loopState
    note right of none
        g1: NOT pr.fork AND placer.may_push
    end note
    note right of none
        g2: pr.same_repo_change_branch AND (pr.refs OR pr.closes) AND standing_grant(...) is not None AND grant_placer.may_push
    end note
