        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="domain" id="page-domain">
    <mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="d-title" value="The domain model: eleven kinds, and where the wiring lives" style="text;html=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="900" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="d-frameA" value="YOU AUTHOR THIS — the wiring" style="rounded=1;arcSize=6;html=0;fillColor=none;strokeColor=#9AA5B1;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#5A6472;fontSize=13;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="1440" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="d-frameB" value="THE OPERATOR MATERIALIZES THIS — you never write it" style="rounded=1;arcSize=6;html=0;fillColor=none;strokeColor=#9AA5B1;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontColor=#5A6472;fontSize=13;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="580" width="1440" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="d-profile" value="AgentProfile" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="210" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-profile-b" value="who the agent is&#10;identity ONLY" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-profile">
          <mxGeometry x="0" y="26" width="210" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-runtime" value="AgentRuntime" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="850" y="110" width="210" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-runtime-b" value="what executes it&#10;image, TTL, volume, SA" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-runtime">
          <mxGeometry x="0" y="26" width="210" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-sigadapter" value="SignalAdapter" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="190" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-sigadapter-b" value="the implementation&#10;image + workload knobs" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-sigadapter">
          <mxGeometry x="0" y="26" width="190" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-sigsource" value="SignalSource" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="190" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-sigsource-b" value="an ingest lane&#10;inert until claimed" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-sigsource">
          <mxGeometry x="0" y="26" width="190" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-pipeline" value="Pipeline" style="swimlane;html=0;startSize=32;fillColor=#D97706;strokeColor=#B5651D;swimlaneFillColor=#FFF7ED;fontColor=#FFFFFF;fontStyle=1;fontSize=17;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="250" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="d-pipeline-b" value="THE WIRING, exclusively&#10;sources x channels + profile&#10;+ tool access" style="text;html=0;align=center;verticalAlign=middle;fontSize=12;fontColor=#7C4A03;fontStyle=1;" vertex="1" parent="d-pipeline">
          <mxGeometry x="0" y="32" width="250" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="d-channel" value="Channel" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="250" width="190" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-channel-b" value="a chat surface&#10;carries, never originates" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-channel">
          <mxGeometry x="0" y="26" width="190" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-chadapter" value="ChannelAdapter" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1120" y="250" width="190" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-chadapter-b" value="the implementation&#10;image + workload knobs" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-chadapter">
          <mxGeometry x="0" y="26" width="190" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-toolset" value="MCPToolset" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="400" width="200" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-toolset-b" value="a list of tool patterns&#10;the allowlist half" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-toolset">
          <mxGeometry x="0" y="26" width="200" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-mcpconfig" value="MCPConfig" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="710" y="400" width="200" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-mcpconfig-b" value="reusable MCP server sets" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-mcpconfig">
          <mxGeometry x="0" y="26" width="200" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-note-profile" value="AgentProfile is identity ONLY.&#10;No allowedTools, no mcp — every&#10;capability edge attaches to Pipeline." style="rounded=1;arcSize=10;html=0;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#7C4A03;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="106" width="310" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="d-conv" value="Conversation" style="swimlane;html=0;startSize=28;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="560" y="630" width="250" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="d-conv-b" value="one incident or task&#10;session + serial input queue&#10;+ one thread per bound channel" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-conv">
          <mxGeometry x="0" y="28" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="d-convinput" value="ConversationInput" style="swimlane;html=0;startSize=26;fillColor=#F5C99B;strokeColor=#1F4E79;swimlaneFillColor=#FFFFFF;fontColor=#1A1A1A;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="648" width="210" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="d-convinput-b" value="out-of-line payloads&#10;keeps CRs small in etcd" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A5568;" vertex="1" parent="d-convinput">
          <mxGeometry x="0" y="26" width="210" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="d-pod" value="runtime pod&#10;(not a CRD)" style="rounded=1;arcSize=14;html=0;fillColor=#D6E4F0;strokeColor=#1F4E79;fontColor=#1A1A1A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="628" width="190" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="d-cm" value="MCP ConfigMap&#10;(not a CRD)" style="rounded=1;arcSize=14;html=0;fillColor=#D6E4F0;strokeColor=#1F4E79;fontColor=#1A1A1A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="700" width="190" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="d-note-conv" value="There is NO pipelineRef.&#10;A Conversation MIRRORS profileRef,&#10;channelRefs[], toolsets and mcpConfigs.&#10;Refs are snapshotted, content is not — so&#10;editing a CR heals running conversations,&#10;while re-wiring affects only new ones." style="rounded=1;arcSize=10;html=0;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#7C4A03;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="620" width="290" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="e-pipe-source" value="signalSourceRefs[]&#10;1..N — each source claimed&#10;by EXACTLY ONE pipeline" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#1F4E79;endArrow=open;endFill=0;fontColor=#1F4E79;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d-pipeline" target="d-sigsource">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-source-adapter" value="spec.adapter&#10;name IS the key" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#1F4E79;endArrow=open;endFill=0;fontColor=#1F4E79;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d-sigsource" target="d-sigadapter">
