metry></mxCell><mxCell id="sock0" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="384" y="296" width="38" height="38" as="geometry"/></mxCell><mxCell id="socke0" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#F59E0B;strokeWidth=2.5;dashed=1;dashPattern=5 5;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zL" target="xt0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sock1" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1224" y="924" width="38" height="38" as="geometry"/></mxCell><mxCell id="socke1" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#F59E0B;strokeWidth=2.5;dashed=1;dashPattern=5 5;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zB" target="xt1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sock2" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1786" y="344" width="38" height="38" as="geometry"/></mxCell><mxCell id="socke2" style="edgeStyle=orthogonalEdgeStyle;html=0;rounded=0;strokeColor=#F59E0B;strokeWidth=2.5;dashed=1;dashPattern=5 5;endArrow=none;startArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="R-i3" target="xt2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="xhead" value="PLUGGABLE AT THREE SEAMS &#8212; documented HTTP contracts, no fork" style="text;html=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1A1A1A;letterSpacing=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="290" y="1240" width="600" height="28" as="geometry"/></mxCell><mxCell id="xt0" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFCF5;strokeColor=#F59E0B;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="48" y="1276" width="380" height="144" as="geometry"/></mxCell><mxCell id="xi0" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="70" y="1318" width="48" height="48" as="geometry"/></mxCell><mxCell id="xl0" value="Your own signal source" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="134" y="1296" width="272" height="28" as="geometry"/></mxCell><mxCell id="xb0" value="Datadog, Dynatrace, Sentry, a sensor on your bench." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="134" y="1326" width="272" height="84" as="geometry"/></mxCell><mxCell id="xt1" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFCF5;strokeColor=#F59E0B;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="480" y="1276" width="820" height="144" as="geometry"/></mxCell><mxCell id="xi1" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="502" y="1318" width="48" height="48" as="geometry"/></mxCell><mxCell id="xl1" value="Your own agent runtime" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="566" y="1296" width="712" height="28" as="geometry"/></mxCell><mxCell id="xb1" value="Codex, Gemini, Copilot or a script of your own. Swap the image &#8212; the work contract does not change." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="566" y="1326" width="712" height="84" as="geometry"/></mxCell><mxCell id="xt2" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFCF5;strokeColor=#F59E0B;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1340" y="1276" width="478" height="144" as="geometry"/></mxCell><mxCell id="xi2" value="" style="shape=image;imageAspect=1;aspect=fixed;html=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1362" y="1318" width="48" height="48" as="geometry"/></mxCell><mxCell id="xl2" value="Your own channel" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1426" y="1296" width="370" height="28" as="geometry"/></mxCell><mxCell id="xb2" value="Slack, Teams, Discord, e-mail. The operator sends meaning; your adapter renders it." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="1426" y="1326" width="370" height="84" as="geometry"/></mxCell><mxCell id="dr0" value="" style="rounded=0;html=0;fillColor=#F59E0B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1462" width="60" height="6" as="geometry"/></mxCell><mxCell id="dt0" value="Judgment, not a fixed sequence" style="text;html=0;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="48" y="1482" width="552" height="30" as="geometry"/></mxCell><mxCell id="db0" value="You describe the job in prose. Nobody enumerates the steps, and nothing has to have been predicted in advance." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15.5;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="48" y="1514" width="552" height="62" as="geometry"/></mxCell><mxCell id="dr1" value="" style="rounded=0;html=0;fillColor=#F59E0B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="652" y="1462" width="60" height="6" as="geometry"/></mxCell><mxCell id="dt1" value="Self-hosted, end to end" style="text;html=0;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="652" y="1482" width="552" height="30" as="geometry"/></mxCell><mxCell id="db1" value="It runs in your cluster on your credentials. No prompt, transcript or alert is sent to a vendor." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15.5;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="652" y="1514" width="552" height="62" as="geometry"/></mxCell><mxCell id="dr2" value="" style="rounded=0;html=0;fillColor=#F59E0B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1256" y="1462" width="60" height="6" as="geometry"/></mxCell><mxCell id="dt2" value="Bounded by construction" style="text;html=0;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1256" y="1482" width="552" height="30" as="geometry"/></mxCell><mxCell id="db2" value="One isolated pod per conversation. Tools come only from the wiring, and the operator itself never reads a Secret." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15.5;fontColor=#5A6472;" vertex="1" parent="1"><mxGeometry x="1256" y="1514" width="552" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
