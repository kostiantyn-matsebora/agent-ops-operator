bin/
*.exe
.envtest/
.serena/

# local Jekyll preview output (the site is built by GitHub Pages, not here)
docs/_site/
docs/.jekyll-cache/
docs/diagrams/.export-work/

# Build artifacts (never commit binaries).
#
# `go build` names its output after the package directory, so a component's
# binary lands beside its source as <group>/<leaf>/<leaf>. Listed by PATTERN
# rather than one line per module: the per-module list silently stopped matching
# the day the tree was regrouped, and eleven stale binaries turned up staged.
platform/*/[!.]*[!.]
signals/*/[!.]*[!.]
channels/*/[!.]*[!.]
gateways/*/[!.]*[!.]
runtimes/*/[!.]*[!.]
!*/*/*.*
!*/*/Dockerfile
!*/*/Makefile
!*/*/README
!*/*/LICENSE
!*/*/[a-z]*/

# Publication-scrub working file. The substitution map is used ONCE and deleted;
# committing it would republish exactly what the scrub removes.
.scrub-map.local

# Coverage profiles CI uploads as artifacts; never committed.
coverage.out
coverage.lcov
