bin/
*.exe
.envtest/
.serena/
__pycache__/

# local Jekyll preview output (the site is built by GitHub Pages, not here)
docs/_site/
docs/.jekyll-cache/
docs/diagrams/.export-work/

# Build artifacts (never commit binaries).
#
# `go build` names its output after the package directory, so a component's
# binary lands beside its source as <group>/<leaf>/<leaf>. Listed by PATTERN
# rather than one line per module: the per-module list silently stopped matching
# the day the tree was regrouped, and eleven stale binaries turned up staged.
platform/*/[!.]*[!.]
signals/*/[!.]*[!.]
channels/*/[!.]*[!.]
gateways/*/[!.]*[!.]
runtimes/*/[!.]*[!.]
!*/*/*.*
!*/*/Dockerfile
!*/*/Makefile
!*/*/README
!*/*/LICENSE
!*/*/[a-z]*/

# npm installs its own tree beside a Node runtime's source; the repo commits
# the lockfile, never the resolved packages — same convention as
# platform/console/ui/.gitignore's own node_modules rule. Listed AFTER the
# `[a-z]*/` re-include above, which would otherwise un-ignore it too, since
# the last matching line wins.
runtimes/*/node_modules/

# Publication-scrub working file. The substitution map is used ONCE and deleted;
# committing it would republish exactly what the scrub removes.
.scrub-map.local

# Coverage profiles CI uploads as artifacts; never committed.
coverage.out
coverage.lcov
.github/coverage.xml
.github/.coverage
.github/.coverage.*

# testing-station.py judge's local verdict/report — already posted to the
# issue as a comment, never committed.
coverage-report/
